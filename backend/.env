# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Public origin under which /r/{slug} is reachable. This is what gets encoded
# into every QR code, so it MUST be the URL end users will scan. Override per
# environment — e.g. https://qr.example.com in production. No trailing slash.
APP_BASE_URL=http://localhost:8000

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Placeholder — set the real value in .env.local (dev) or docker-compose / root .env (prod).
# Generate one with:  openssl rand -hex 32
JWT_PASSPHRASE=change-me-set-real-value-in-env-local-or-docker-env
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
###< symfony/messenger ###

# Redis connection used by both the cache pool (cache.yaml) and the Messenger
# transport. In docker-compose this points to the redis service.
REDIS_URL=redis://redis:6379

# GeoLite2-Country MaxMind database. Mounted as a read-only volume in
# docker-compose; the file itself MUST NOT be committed (MaxMind licence).
# If the file is absent, scan logging still works but country stays NULL.
GEOIP_DATABASE_PATH=/app/var/geoip/GeoLite2-Country.mmdb

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

# Rate limit for POST /api/links (per authenticated user).
# Tune higher in trusted setups; the defaults stop abusive scripts cold.
LINK_CREATION_RATE_PER_MINUTE=10
LINK_CREATION_BURST=20

# Hosts forbidden as link destinations. Empty by default — we ship the
# mechanism, not a policy. Comma- or whitespace-separated. Prefix a rule
# with a dot to also block subdomains, e.g.:
#   LINK_DESTINATION_DENYLIST="bad.example, .spam.example, malware.test"
LINK_DESTINATION_DENYLIST=

# Demo account auto-expiry. If DEMO_USER_EMAIL is set, links owned by that
# user are deleted after DEMO_LINK_TTL_HOURS by the periodic `cron` service.
# Leave DEMO_USER_EMAIL empty to disable. Use this when exposing a public
# demo so it doesn't become a free spam launchpad.
DEMO_USER_EMAIL=
DEMO_LINK_TTL_HOURS=24

# --- Billing (Merchant of Record: Paddle) --------------------------------
# Subscriptions go through Paddle (the MoR handles checkout, cards/PCI and
# tax/VAT). These are SAFE, non-secret defaults. The actual secrets
# (PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET) MUST live in .env.local / real env
# vars and are NEVER committed.
BILLING_TRIAL_DAYS=14
# Grace window (days) after a subscription's period ends before its codes
# switch from their destination to their fallback URL (fallback milestone).
BILLING_GRACE_DAYS=30
# Code limits per plan — the SINGLE source, reused by both the pricing page
# (/api/pricing) and the billing enforcement (link creation). <= 0 = unlimited.
PLAN_TRIAL_CODE_LIMIT=3
PLAN_STARTER_CODE_LIMIT=10
PLAN_PRO_CODE_LIMIT=0
# Paddle API base. Use the sandbox while testing, https://api.paddle.com in prod.
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
# Paddle price ids (pri_...) each paid plan checks out against, and that the
# pricing page reads live amounts + active discounts from. Empty = that plan is
# not purchasable on this instance.
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
# Legacy single-price knob (billing milestone). Used as a fallback for the Pro
# price when PADDLE_PRO_PRICE_ID is empty; prefer the per-plan ids above.
PADDLE_PRICE_ID=
# How long (seconds) /api/pricing caches the Paddle catalogue. Keep it short.
PRICING_CACHE_TTL=600
# Secrets — leave empty here; set in .env.local (dev) or env/secrets (prod).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Admin panel (operator-only, read-only) ------------------------------
# Admin is granted out-of-band ONLY (never via signup): `bin/console
# app:admin:grant <email>` (sets ROLE_ADMIN + enrols 2FA) or this allowlist.
# Comma/space-separated emails that are also treated as admins. 2FA is still
# mandatory — enrol via the CLI even for allow-listed emails.
ADMIN_ALLOWLIST=
# Optional: restrict the admin surface to these exact request IPs (comma/space).
# Empty = no IP restriction (mechanism only).
ADMIN_IP_ALLOWLIST=
# Per-IP brute-force limit on POST /admin/login.
ADMIN_LOGIN_RATE_PER_MINUTE=5
ADMIN_LOGIN_BURST=5
# How long (seconds) the panel caches the Paddle-sourced business KPIs.
ADMIN_METRICS_CACHE_TTL=300
