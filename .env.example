# qr-code-redirect — self-host configuration.
#
# Copy this file to `.env` (same directory as docker-compose.yml) and tweak
# anything you want to deviate from the defaults. Every variable here has a
# sane default in docker-compose.yml, so you can also leave `.env` empty.
#
# After editing, restart the stack:    docker compose up -d

# --- Environment ---------------------------------------------------------
# Set to "prod" to disable the Symfony profiler/debug tooling. Use "dev"
# only on a machine you fully control.
APP_ENV=prod

# Application secret used for CSRF / signed URIs. Generate one with:
#   openssl rand -hex 32
APP_SECRET=change-me-with-openssl-rand-hex-32

# Public origin under which /r/{slug} is reachable. This is what gets
# baked into every QR code, so it MUST be the URL your users will scan.
# In dev: http://localhost:8000. In prod: https://qr.example.com (no trailing /).
APP_BASE_URL=http://localhost:8000

# --- Database ------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-please
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
# Used by: slug→destination cache + Messenger transport + rate limiter.
REDIS_PORT=6379

# --- HTTP ports ----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=4200

# --- JWT auth ------------------------------------------------------------
# Passphrase used to encrypt the generated private key on disk.
# The keypair itself is generated automatically inside the container on
# first boot if it doesn't exist yet — you don't need openssl on the host.
# Generate a passphrase with:    openssl rand -hex 32
JWT_PASSPHRASE=change-me-with-openssl-rand-hex-32

# --- CORS ----------------------------------------------------------------
# Regex of allowed origins for the management API. Default covers any
# localhost port (handy in dev). Lock this down in prod, e.g.:
#   CORS_ALLOW_ORIGIN=^https://qr\.example\.com$
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# --- Rate limiting -------------------------------------------------------
# Per-user budget for POST /api/links. Tune higher in trusted setups.
LINK_CREATION_RATE_PER_MINUTE=10
LINK_CREATION_BURST=20

# --- Destination denylist -----------------------------------------------
# Hosts that may NEVER be used as a link destination. Empty default — we
# ship the mechanism, you write the policy. Comma- or whitespace-separated.
# A leading dot makes a rule match subdomains too. Example:
#   LINK_DESTINATION_DENYLIST="bad.example, .spam.example, malware.test"
LINK_DESTINATION_DENYLIST=

# --- Demo account auto-expiry -------------------------------------------
# If DEMO_USER_EMAIL is set, links owned by that account are deleted
# automatically by the `cron` service after DEMO_LINK_TTL_HOURS.
# Recommended for public demos so they don't become spam launchpads.
# Leave DEMO_USER_EMAIL empty to disable.
DEMO_USER_EMAIL=
DEMO_LINK_TTL_HOURS=24
DEMO_PURGE_INTERVAL_SECONDS=900

# --- GeoLite2 ------------------------------------------------------------
# The MaxMind GeoLite2-Country database powers IP → country resolution
# for scans. It is NOT shipped with the repo (licence). Drop the file at
#   backend/var/geoip/GeoLite2-Country.mmdb
# (see that directory's README). The stack runs fine without it; scans
# just won't have a country set.
